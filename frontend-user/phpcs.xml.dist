<?xml version="1.0"?>
<ruleset name="MusicPlatform">
    <description>Music Platform PSR-12 Coding Standard</description>
    <arg name="colors"/>
    <arg value="p"/>

    <file>app/</file>
    <file>tests/</file>

    <exclude-pattern>vendor/</exclude-pattern>
    <exclude-pattern>runtime/</exclude-pattern>
    <exclude-pattern>public/assets/</exclude-pattern>

    <rule ref="PSR12"/>
</ruleset>
